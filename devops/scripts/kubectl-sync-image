#!/usr/bin/env bash
# kubectl-sync-image — chạy image-watcher ngay lập tức, không chờ hết phút cron.
#
# Cài thành kubectl plugin (gọi được bằng `kubectl sync-image`):
#   sudo ln -sf "$PWD/devops/scripts/kubectl-sync-image" /usr/local/bin/kubectl-sync-image
#
# Dùng:
#   kubectl sync-image                      # context mặc định: multipass
#   kubectl sync-image --context my-ctx
#   KUBE_CONTEXT=prod kubectl sync-image
set -euo pipefail

CTX="${KUBE_CONTEXT:-multipass}"
NS="${KUBE_NAMESPACE:-default}"
CRONJOB="${IMAGE_WATCHER_CRONJOB:-frankenphp-image-watcher}"

usage() {
  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
}

while [ $# -gt 0 ]; do
  case "$1" in
    --context)      CTX="$2"; shift 2 ;;
    -n|--namespace) NS="$2";  shift 2 ;;
    -h|--help)      usage; exit 0 ;;
    *) echo "tham số không hiểu: $1" >&2; usage >&2; exit 2 ;;
  esac
done

K=(kubectl --context "$CTX" -n "$NS")
JOB="image-watcher-now-$(date +%Y%m%d-%H%M%S)"

# Job tạm này xoá luôn khi script kết thúc, kể cả khi bị Ctrl-C
cleanup() { "${K[@]}" delete job "$JOB" --wait=false >/dev/null 2>&1 || true; }
trap cleanup EXIT

echo "==> chạy $CRONJOB một lần (context=$CTX ns=$NS)"
"${K[@]}" create job "$JOB" --from="cronjob/$CRONJOB" >/dev/null

# Chờ pod của job xuất hiện
pod=""
for _ in $(seq 1 60); do
  pod=$("${K[@]}" get pod -l "job-name=$JOB" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)
  [ -n "$pod" ] && break
  sleep 1
done
[ -n "$pod" ] || { echo "LỖI: job $JOB không tạo được pod" >&2; exit 1; }

# Chờ container khởi động rồi stream log ra luôn
"${K[@]}" wait --for=jsonpath='{.status.phase}'=Running "pod/$pod" --timeout=120s >/dev/null 2>&1 || true
"${K[@]}" logs -f "pod/$pod" 2>/dev/null || "${K[@]}" logs "pod/$pod" || true

# Exit code lấy theo kết quả thật của container
for _ in $(seq 1 30); do
  phase=$("${K[@]}" get "pod/$pod" -o jsonpath='{.status.phase}' 2>/dev/null || true)
  case "$phase" in
    Succeeded) echo "==> xong"; exit 0 ;;
    Failed)    echo "==> job thất bại" >&2; exit 1 ;;
  esac
  sleep 2
done
echo "==> hết thời gian chờ, job vẫn đang chạy" >&2
exit 1
